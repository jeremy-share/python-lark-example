// Entry point of the grammar.
// An expression is a single boolean or a sequence of booleans connected by "and"/"or".
?start: expr

// expr is a flat sequence: boolean [op boolean]...
// This does not implement operator precedence — it is evaluated strictly left to right.
?expr: boolean (BOOL_OP boolean)*

// Supported boolean operators (no precedence between them)
BOOL_OP: "and" | "or"

// Boolean literals
boolean: boolean_true | boolean_false
boolean_true: "true"
boolean_false: "false"

// Ignore whitespace between tokens
%import common.WS
%ignore WS

// =====================================================================================================================
// Key Clarifications:
//?expr produces a flat list of tokens ([boolean, "and", boolean, "or", boolean, ...]) — no nested tree nodes that distinguish precedence.
//Operator precedence is not enforced in the grammar.
//? means the rule is inline, so it won't create a separate tree node unless needed.
